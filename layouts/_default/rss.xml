{{- $authorEmail := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .email }}
      {{- $authorEmail = . }}
    {{- end }}
  {{- end }}
{{- end }}

{{- $authorName := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .name }}
      {{- $authorName = . }}
    {{- end }}
  {{- else }}
    {{- $authorName  = . }}
  {{- end }}
{{- end }}

{{- $pctx := . }}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end }}
{{- $pages := slice }}
{{- if or $.IsHome $.IsSection }}
{{- /* Site.RegularPages is already site-wide; a section needs the recursive variant to include sub-folders. */}}
{{- if $.IsHome }}{{ $pages = $pctx.RegularPages }}{{ else }}{{ $pages = $pctx.RegularPagesRecursive }}{{ end }}
{{- /* Jogger is Polish and stays off the homepage; it has its own feed. */}}
{{- if $.IsHome }}{{ $pages = where $pages "Section" "ne" "jogger" }}{{ end }}
{{- else }}
{{- $pages = $pctx.Pages }}
{{- end }}
{{- /* Every entry is listed; only the newest $fullItems carry full text, the rest carry summaries. */}}
{{- $fullItems := site.Params.rssFullItems | default 10 }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ if ne .Title .Site.Title }}{{ with .Title }}in {{ . }} {{ end }}{{ end }}on {{ .Site.Title }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>{{ with $authorEmail }}
    <managingEditor>{{.}}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>{{ end }}{{ with $authorEmail }}
    <webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>{{ end }}{{ with .Site.Copyright }}
    <copyright>{{ . }}</copyright>{{ end }}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $i, $p := where $pages "Params.excludeFromRSS" "ne" true }}
    {{- with $p }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with $authorEmail }}<author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>{{ end }}
      <guid>{{ .Permalink }}</guid>
      {{- if lt $i $fullItems }}
      <description>{{ .Content | transform.XMLEscape | safeHTML }}</description>
      {{- else }}
      <description>{{ .Summary | transform.XMLEscape | safeHTML }}</description>
      {{- end }}
      {{ $original_image := .Resources.GetMatch "**.jpg" }}
      {{ if isset .Params "image" }}
      <image>
        <title>{{ .Title }}</title>
        <url>
          {{- .Site.BaseURL }}{{ .Params.image -}}
        </url>
      </image>
      {{ else if $original_image }}
      <image>
        <title>{{ .Title }}</title>
        <url>
          {{- $original_image.Permalink -}}
        </url>
      </image>
      {{ end }}
    </item>
    {{- end }}
    {{- end }}
  </channel>
</rss>
